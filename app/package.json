{
  "name": "campus-assistant",
  "version": "0.9.9-hotfix",
  "description": "ToDoList - personal tasks, schedules and message digest",
  "main": "./out/main/index.js",
  "author": "SillyJay",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:backend": "powershell -ExecutionPolicy Bypass -File ../build-backend.ps1",
    "build:win": "npm run build && electron-builder --win",
    "build:win:offline": "npm run build && electron-builder --dir --config.win.signAndEditExecutable=false --config.electronDist=node_modules/electron/dist",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "electron": "37.10.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "lucide-react": "^1.61.0",
    "mammoth": "^1.13.0",
    "prettier": "^3.9.10",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-big-calendar": "^1.20.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^2.1.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "xlsx": "^0.18.5"
  }
}
